# =============================================================================
# .env.example - Variáveis de ambiente do projeto Cardápio Online SaaS
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# --- Django ---
SECRET_KEY=troque-por-uma-chave-secreta-forte-gerada-com-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.meusistema.com
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://127.0.0.1:8000
DJANGO_SETTINGS_MODULE=config.settings
NGINX_PORT=8081

# --- Banco de dados PostgreSQL ---
POSTGRES_DB=cardapio_oneda
POSTGRES_USER=cardapio_user
POSTGRES_PASSWORD=senha_segura_aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- PIX Manual ---
# Chave PIX fixa do estabelecimento (CNPJ, CPF, email, telefone ou chave aleatória)
PIX_KEY=seu_cpf_ou_cnpj_ou_chave_pix

# --- Domínio base (multi-tenant) ---
BASE_DOMAIN=meusistema.com
SITE_URL=http://localhost:8081

# --- Email (opcional, para notificações) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app

# --- Superuser inicial (usado no seed) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@meusistema.com
DJANGO_SUPERUSER_PASSWORD=admin123mudar
