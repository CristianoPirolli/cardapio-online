# =============================================================================
# .gitignore - Arquivos e diretórios ignorados pelo Git
# =============================================================================

# Ambiente virtual Python
venv/
.venv/
env/

# Variáveis de ambiente (NUNCA commitar)
.env
.env.*
!.env.example

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Banco de dados SQLite (dev)
db.sqlite3

# Arquivos de media (uploads dos usuários)
media/

# Arquivos estáticos coletados
staticfiles/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
postgres_data/

# Certbot
nginx/certbot/

# Runtime
gunicorn.ctl
*.log
node_modules/

# OS
.DS_Store
Thumbs.db

# Planejamento e documentação
.planning/
